# Flask
SECRET_KEY=replace-with-a-long-random-secret

# Firebase Admin SDK
# Option A: path to your downloaded Firebase service-account JSON file.
# Keep the JSON file OUT of GitHub.
FIREBASE_CREDENTIALS=firebase-service-account.json

# Optional: your Firebase/Google Cloud project ID
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional: Firebase Storage bucket, if you later move profile images to Cloud Storage
# FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Optional SkillBridge AI
# OPENAI_API_KEY=your-server-side-key
# OPENAI_MODEL=gpt-5.6-luna
